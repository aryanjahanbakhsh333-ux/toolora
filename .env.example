# .env.example - Example Environment Configuration
# Copy this file to .env and update values for your environment

# Application Settings
APP_NAME=Toolora
APP_DESCRIPTION=Online Tools Platform
APP_VERSION=1.0.0

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=False
RELOAD=False

# Database
DATABASE_URL=sqlite:///./toolora.db

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,toolora.com
CORS_ORIGINS=https://toolora.com,https://www.toolora.com

# Google Analytics
GOOGLE_ANALYTICS_ID=

# Email Configuration (Optional)
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=info@toolora.com

# API Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=100

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/toolora.log

# Features
ENABLE_REGISTRATION=False
ENABLE_DASHBOARD=False
ENABLE_PREMIUM=False
